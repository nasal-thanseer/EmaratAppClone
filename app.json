{
  "expo": {
    "name": "Nawa Rewards",
    "slug": "nawa-rewards",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "nawarewards",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Nawa Rewards to scan member and redemption QR codes.",
          "recordAudioAndroid": false
        }
      ],
      "expo-font",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nawarewards.app"
    },
    "android": {
      "package": "com.nawarewards.app",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    }
  }
}
